---
import type { CollectionEntry } from 'astro:content';
import PostArticle from '../../components/PostArticle.astro';
import { allPublishedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  return (await allPublishedPosts()).filter(post => !post.data.legacyPath).map(post => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
---
<PostArticle post={post} />
