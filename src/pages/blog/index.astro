---
import CategoryNav from '../../components/CategoryNav.astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/posts';
const posts = await publishedPosts();
---
<Base title="Writing" description="Notes on machine learning, the web, open source, and whatever rabbit hole I'm currently falling into. Occasionally my own research subject.">
  <section class="page-intro"><p class="eyebrow"></p><h1>Writing.</h1><p class="lede">Notes on machine learning, the web, open source, and whatever rabbit hole I'm currently falling into. Occasionally my own research subject.</p></section>
  <CategoryNav />
  <div class="section-heading"><h2>All posts</h2><span>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span></div>
  <PostList posts={posts} />
</Base>
