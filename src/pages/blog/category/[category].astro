---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import { categorySlug, publishedPosts } from '../../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return [...new Set(posts.map(post => post.data.category))].map(category => ({ params: { category: categorySlug(category) }, props: { category } }));
}
const { category } = Astro.props;
const posts = (await publishedPosts()).filter(post => post.data.category === category);
---
<Base title={`${category} — Writing`} description={`Essays and notes filed under ${category}.`}>
  <section class="page-intro"><p class="eyebrow">The notebook</p><h1>Writing.</h1><p class="lede">Ideas, experiments, and things worth writing down.</p></section>
  <CategoryNav selected={category} />
  <div class="section-heading"><h2>{category}</h2><span>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span></div>
  <PostList posts={posts} />
</Base>
